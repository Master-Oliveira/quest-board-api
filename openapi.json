{
  "openapi": "3.0.3",
  "info": {
    "title": "Adventurers' Guild API",
    "version": "1.0.0",
    "description": "In-memory quest and adventurer management. All writable fields are required for POST and PUT. PUT replaces writable fields; id, createdAt, objectives, and aiGenerated are server-managed. Data resets on restart. JSON request bodies are limited to 64 KiB."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/model/test": {
      "post": {
        "summary": "Test the Foundry model",
        "description": "Local development only: unauthenticated, billable model call. Requests must come from a loopback address with a localhost, 127.0.0.1, or [::1] Host header. At most two model calls run at once. Input is trimmed after validating its supplied length (Unicode code points). Output is limited to 512 tokens by default (MODEL_TEST_MAX_OUTPUT_TOKENS, 16-4096); incomplete responses fail instead of returning partial text. Uses a 30-second deadline with no retries, and the model call is cancelled if the client disconnects.",
        "requestBody": {
          "required": true,
          "content": { "application/json": {
            "schema": { "$ref": "#/components/schemas/ModelTestInput" },
            "example": { "input": "Reply with a short greeting." }
          } }
        },
        "responses": {
          "200": {
            "description": "Completed model text",
            "content": { "application/json": {
              "schema": { "$ref": "#/components/schemas/ModelTestResult" },
              "example": { "text": "Hello, adventurer!" }
            } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": {
            "description": "FORBIDDEN: the request did not come from a local client and Host",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "405": {
            "description": "Only POST is allowed",
            "headers": { "Allow": { "schema": { "type": "string", "enum": ["POST"] } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": {
            "description": "TOO_MANY_REQUESTS: two model calls are already in progress",
            "headers": { "Retry-After": { "schema": { "type": "string", "example": "1" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "CONFIGURATION_ERROR or unexpected INTERNAL_ERROR",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "502": {
            "description": "AUTHENTICATION_ERROR, MODEL_REQUEST_REJECTED, MODEL_NOT_FOUND, or INVALID_MODEL_RESPONSE",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "503": {
            "description": "MODEL_UNAVAILABLE: temporary throttling, server, or connection failure",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "504": {
            "description": "MODEL_TIMEOUT",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/quests": {
      "get": {
        "summary": "List quests",
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["open", "in-progress", "completed"] } },
          { "name": "difficulty", "in": "query", "schema": { "type": "string", "enum": ["easy", "medium", "hard", "legendary"] } }
        ],
        "responses": {
          "200": { "description": "Quests matching all provided filters", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Quest" } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "post": {
        "summary": "Create a quest",
        "requestBody": { "$ref": "#/components/requestBodies/Quest" },
        "responses": {
          "201": {
            "description": "Created",
            "headers": { "Location": { "description": "URL of the created quest", "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Quest" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/quests/generate": {
      "post": {
        "summary": "Generate an AI quest for an adventurer",
        "description": "Local development only: unauthenticated, billable Foundry model call. Requests must come from a loopback address with a localhost, 127.0.0.1, or [::1] Host header, and share the two-call model concurrency limit with POST /model/test. The application loads the adventurer, asks the model for a structured quest, and enforces the guild rules before saving: difficulty matches the request; minimumLevel is between max(1, adventurer level - 5) and the adventurer level; rewards fall in the difficulty band (easy gold 10-60 / XP 25-150, medium 75-300 / 150-600, hard 400-1200 / 700-2000, legendary 2000-8000 / 4000-12000); 3 to 5 objectives. The quest is saved with status open and aiGenerated true, and then behaves like any other quest. Nothing is saved on failure. Invalid bodies and unknown adventurers are rejected before the concurrency limit. Output is limited to 2048 tokens by default (QUEST_GENERATION_MAX_OUTPUT_TOKENS, 256-16384). Uses a 30-second deadline with no retries; the model call is cancelled if the client disconnects. A valid X-Request-Id header (1-128 letters, digits, '.', '_', or '-') is reused; otherwise a UUID is generated.",
        "parameters": [
          { "name": "X-Request-Id", "in": "header", "required": false, "schema": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" }, "description": "Optional correlation ID echoed in the response and written to logs" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": {
            "schema": { "$ref": "#/components/schemas/QuestGenerationRequest" },
            "example": { "adventurerId": "adventurer-1", "theme": "haunted lighthouse", "difficulty": "medium" }
          } }
        },
        "responses": {
          "201": {
            "description": "Generated and saved quest",
            "headers": {
              "Location": { "description": "URL of the created quest", "schema": { "type": "string" } },
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
            },
            "content": { "application/json": {
              "schema": { "$ref": "#/components/schemas/Quest" },
              "example": {
                "id": "6f1c2b9e-5d1a-4f7e-9c3b-2a8d7e6f5c4b", "title": "The Lantern Wraith",
                "description": "A restless spirit has darkened the coastal lighthouse.",
                "difficulty": "medium", "minimumLevel": 4, "goldReward": 150, "experienceReward": 300,
                "status": "open", "createdAt": "2026-11-17T22:40:00.000Z",
                "objectives": ["Reach the lighthouse", "Relight the lantern", "Banish the wraith"],
                "aiGenerated": true
              }
            } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": {
            "description": "FORBIDDEN: the request did not come from a local client and Host",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "NOT_FOUND: unknown adventurerId",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "405": {
            "description": "Only POST is allowed",
            "headers": { "Allow": { "schema": { "type": "string", "enum": ["POST"] } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": {
            "description": "TOO_MANY_REQUESTS: two model calls are already in progress",
            "headers": { "Retry-After": { "schema": { "type": "string", "example": "1" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "CONFIGURATION_ERROR or unexpected INTERNAL_ERROR",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "502": {
            "description": "INVALID_MODEL_RESPONSE (empty, incomplete, or malformed output), INVALID_GENERATED_QUEST (output breaks guild rules; details list the fields), AUTHENTICATION_ERROR, MODEL_REQUEST_REJECTED, or MODEL_NOT_FOUND",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "503": {
            "description": "MODEL_UNAVAILABLE: temporary throttling, server, or connection failure",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "504": {
            "description": "MODEL_TIMEOUT",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/quests/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "summary": "Get a quest",
        "responses": {
          "200": { "description": "Quest", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Quest" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "summary": "Replace all writable quest fields",
        "requestBody": { "$ref": "#/components/requestBodies/Quest" },
        "responses": {
          "200": { "description": "Updated quest", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Quest" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      },
      "delete": {
        "summary": "Delete a quest",
        "responses": {
          "204": { "description": "Deleted; no response body" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/adventurers": {
      "get": {
        "summary": "List adventurers",
        "responses": {
          "200": { "description": "Adventurers", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Adventurer" } } } } }
        }
      },
      "post": {
        "summary": "Create an adventurer",
        "requestBody": { "$ref": "#/components/requestBodies/Adventurer" },
        "responses": {
          "201": {
            "description": "Created",
            "headers": { "Location": { "description": "URL of the created adventurer", "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Adventurer" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/adventurers/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "summary": "Get an adventurer",
        "responses": {
          "200": { "description": "Adventurer", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Adventurer" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "summary": "Replace all writable adventurer fields",
        "requestBody": { "$ref": "#/components/requestBodies/Adventurer" },
        "responses": {
          "200": { "description": "Updated adventurer", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Adventurer" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      },
      "delete": {
        "summary": "Delete an adventurer",
        "responses": {
          "204": { "description": "Deleted; no response body" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Opaque resource ID (seed IDs or generated UUIDs)" }
    },
    "headers": {
      "RequestId": { "description": "Correlation ID for this request (client-supplied if valid, otherwise a generated UUID)", "schema": { "type": "string" } }
    },
    "requestBodies": {
      "Quest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Quest" } } } },
      "Adventurer": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Adventurer" } } } }
    },
    "schemas": {
      "ModelTestInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input"],
        "properties": {
          "input": { "type": "string", "minLength": 1, "maxLength": 5000, "pattern": "\\S" }
        }
      },
      "ModelTestResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      },
      "QuestGenerationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adventurerId", "theme", "difficulty"],
        "properties": {
          "adventurerId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
          "theme": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
          "difficulty": { "type": "string", "enum": ["easy", "medium", "hard", "legendary"] }
        }
      },
      "Quest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "difficulty", "minimumLevel", "goldReward", "experienceReward", "status", "createdAt", "objectives", "aiGenerated"],
        "properties": {
          "id": { "type": "string", "readOnly": true },
          "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
          "description": { "type": "string", "minLength": 1, "maxLength": 5000, "pattern": "\\S" },
          "difficulty": { "type": "string", "enum": ["easy", "medium", "hard", "legendary"] },
          "minimumLevel": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "goldReward": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "experienceReward": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "status": { "type": "string", "enum": ["open", "in-progress", "completed"] },
          "createdAt": { "type": "string", "format": "date-time", "readOnly": true },
          "objectives": { "type": "array", "maxItems": 5, "readOnly": true, "description": "AI-generated quests have 3 to 5 objectives; other quests have none", "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
          "aiGenerated": { "type": "boolean", "readOnly": true, "description": "True when created by POST /quests/generate" }
        }
      },
      "Adventurer": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "level", "experience", "gold", "status"],
        "properties": {
          "id": { "type": "string", "readOnly": true },
          "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
          "level": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "experience": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "gold": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "status": { "type": "string", "enum": ["active", "inactive"] }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": { "type": "array", "items": {
                "type": "object",
                "required": ["field", "message"],
                "properties": { "field": { "type": "string" }, "message": { "type": "string" } }
              } }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": { "description": "Invalid JSON, fields, or quest filters (unknown and duplicate quest filters are rejected)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Resource not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "TooLarge": { "description": "Body exceeds 64 KiB", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "UnsupportedMediaType": { "description": "Content-Type must be application/json", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
